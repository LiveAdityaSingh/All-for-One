<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Android 13+ makes this a runtime permission. It is requested right
      after the user's first capture, never at launch (build spec §6).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The nightly digest must fire on OEMs (Samsung, Xiaomi, OnePlus,
      Oppo) that aggressively kill inexact background work regardless of
      what Android's documentation promises (build spec §12), so the
      digest is scheduled as an exact alarm.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Re-registers the scheduled digest after a device restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      NOT YET DECLARED: REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, needed for
      the onboarding battery-exemption prompt (build spec §12). Google
      Play restricts that permission and rejects apps that declare it
      without a qualifying use, so it should be added in the same change
      that ships the prompt itself - not ahead of it.
    -->
</manifest>
